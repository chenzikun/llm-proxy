PORT=3000
DEBUG=false
HTTPS_PROXY=http://localhost:7890

# 首次启动时创建的 root 账号，留空使用默认值 root / 123456。
# 仅在数据库中没有任何用户时生效，之后修改不会影响已有账号，需要改密码请登录后台修改。
INITIAL_ROOT_USERNAME=
INITIAL_ROOT_PASSWORD=

# ── 数据库 ──────────────────────────────────────────────────────────────
# 用法： docker compose --env-file ubuntu.env -f docker-compose.prod.yml ...
# 生产 compose 里 DB_TYPE 是必填的：不声明连哪个库，compose 会直接报错拒绝启动，
# 免得漏配之后悄悄起一个空的 SQLite。选定类型的必填参数缺失同样会启动失败。
#
# 数据库类型：mysql / postgres / sqlite
#DB_TYPE=mysql
#
# DB_TYPE=mysql 时使用，MYSQL_HOST 必填
#MYSQL_HOST=
#MYSQL_PORT=3306
#MYSQL_USERNAME=llm_proxy
#MYSQL_PASSWORD=
#MYSQL_DB=llm_proxy
#
# DB_TYPE=postgres 时使用，PG_HOST 必填
#PG_HOST=
#PG_PORT=5432
#PG_USER=llm_proxy
#PG_PASSWORD=
#PG_DB=llm_proxy
#
# 也可以直接给完整连接串，此时以它为准、按 postgres:// 前缀判断类型，DB_TYPE 不再生效
#SQL_DSN=
